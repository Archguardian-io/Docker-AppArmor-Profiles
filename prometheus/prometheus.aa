profile promprometheus.aa flags=(attach_disconnected) {
  signal,
  ptrace,
  network,
  capability,
  /bin/prometheus rix,
  /etc/prometheus/prometheus.yml r,
  /sys/kernel/mm/hugepages rix,
  /etc/localtime r,
  /sys/fs/cgroup/hugetlb.1GB.current r,
  /sys/kernel/mm/transparent_hugepage/hpage_pmd_size r,
  /proc/sys/net/core/somaxconn r,
  /prometheus/queries.active rwm,
  /sys/fs/cgroup/rdma.current r,
  /prometheus/chunks_head/ rwix,
  /etc/nsswitch.conf r,
  /sys/fs/cgroup/cpu.stat r,
  /sys/fs/cgroup/memory.swap.max r,
  /etc/resolv.conf r,
  /sys/fs/cgroup/memory.current r,
  /prometheus/ rwix,
  /proc/*/net/netstat r,
  /sys/fs/cgroup/io.pressure r,
  /sys/fs/cgroup/memory.max r,
  /sys/fs/cgroup/memory.pressure r,
  /etc/passwd r,
  /proc/*/stat r,
  /sys/fs/cgroup/pids.current r,
  /prometheus/lock rwk,
  /proc/*/limits r,
  /sys/fs/cgroup/cpu.max r,
  /proc/*/cgroup r,
  /sys/fs/cgroup/hugetlb.1GB.max r,
  /sys/fs/cgroup/hugetlb.2MB.max r,
  /sys/fs/cgroup/io.stat r,
  /sys/fs/cgroup/cpu.pressure r,
  /sys/fs/cgroup/memory.stat r,
  /proc/stat r,
  /prometheus/wal/ rwix,
  /etc/hosts r,
  /proc/*/mountinfo r,
  /sys/fs/cgroup/memory.events r,
  /sys/fs/cgroup/hugetlb.2MB.current r,
  /sys/fs/cgroup/cgroup.controllers r,
  /sys/fs/cgroup/rdma.max r,
  /sys/fs/cgroup/pids.max r,
  /proc/*/fd rix,
  /sys/fs/cgroup/memory.swap.current r,
  /sys/fs/cgroup/ r,
  /sys/fs/ r,
  /sys/fs/cgroup r,
  /usr/sbin/runc ix,
  / r,
  /sys/ r,
  /proc/self/attr/apparmor/ r,
  /proc/self/attr/apparmor/exec rw,
  /bin/ r,
  /run/** rwixk,
  /dev/stderr r,
  /proc/self/fd/* rw,
  /proc/self/ r,
  /proc/self/uid_map r,
  /etc/ r,
  /proc/*/net/ r,
  /usr/lib/x86_64-linux-gnu/libc.so.6 rm,
  /dev/ r,
  /dev/mqueue rw,
  /dev/null rw,
  /sys/kernel/mm/hugepages/ r,
  /proc/*/ r,
  /proc/sys/net/ipv4/ r,
  /proc/sys/net/ipv4/ip_unprivileged_port_start rw,
  /lib/x86_64-linux-gnu/ r,
  /lib/x86_64-linux-gnu/libc.so.6 r,
  /sys/kernel/mm/transparent_hugepage/ r,
  /proc/self/mountinfo r,
  /dev/urandom rw,
  /proc/sys/kernel/ r,
  /proc/sys/kernel/cap_last_cap r,
  /proc/self/exe r,
  /proc/sys/net/core/ r,
  /proc/self/setgroups r,
  /proc/self/fd rw,
  /dev/pts/ rw,
  /proc/ r,
  /dev/core r,
  /proc/kcore w,
  /proc/self/status r,
  /etc/prometheus/ r,
  /lib/x86_64-linux-gnu/libseccomp.so.2 rm,
  /dev/shm/** rwk,
  /proc/filesystems r,
  /dev/stdin r,
  /proc/self/cgroup r,
  /dev/stdout r,
  /etc/hostname r,
  /proc/sys/net/ipv4/ping_group_range rw,
  /etc/group r,
  /dev/full rw,
  /proc/self/oom_score_adj rw,
  /etc/ld.so.cache rm,
  /dev/random rw,
  /dev/ptmx r,
  /proc/self/fd/ r,
  /dev/zero rw,
  /dev/fd r,
  /dev/tty rw,
  /usr/lib/x86_64-linux-gnu/libseccomp.so.2.5.5 rm,
  /prometheus/wal/* rw,
  /tmp/ r,
}
